import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { File } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { DatePicker } from "@elements/ui/date-picker";
import { Field } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";
import { TimePicker } from "@elements/ui/time-picker";
import { toast } from "@elements/ui/toast";
import { AdminShell } from "#app/shared/templates/admin-shell";
import { Photo, photoUrl } from "#app/shared/services/wedding";
import {
  SiteForm,
  EventForm,
  HotelForm,
  saveSite,
  saveEvent,
  deleteEvent,
  saveHotel,
  deleteHotel,
  uploadPhotos,
  captionPhoto,
  movePhoto,
  deletePhoto,
  setCover,
} from "./services";

interface Editor {
  site: SiteForm;
  events: EventForm[];
  hotels: HotelForm[];
  photos: Photo[];
  editingEvent: EventForm | null;
  editingHotel: HotelForm | null;
  files: File[];
  error: { section: string; message: string };
}

function blankEvent(site: SiteForm): EventForm {
  return { id: "", name: "", startsLocal: site.weddingLocal, place: "", address: "", attire: "", details: "" };
}

function blankHotel(): HotelForm {
  return { id: "", name: "", address: "", url: "", details: "" };
}

function flash(ed: Editor, message: string) {
  ed.error = { section: "", message: "" };
  toast.success(message);
}

/** The date of a "YYYY-MM-DDTHH:MM" local time. */
export function datePart(local: string): string {
  return local.split("T")[0] ?? "";
}

/** The time of a "YYYY-MM-DDTHH:MM" local time. */
export function timePart(local: string): string {
  return (local.split("T")[1] ?? "").slice(0, 5);
}

export function joinLocal(date: string, time: string): string {
  return `${date}T${time || "00:00"}`;
}

function fail(ed: Editor, section: string, err: any) {
  ed.error = { section, message: err.message };
}

function onSaveSite(ed: Editor, section: string) {
  try {
    ed.site = saveSite(ed.site);
    flash(ed, "Saved");
  } catch (err: any) {
    fail(ed, section, err);
  }
}

function onSaveEvent(ed: Editor) {
  try {
    ed.events = saveEvent(ed.editingEvent!);
    ed.editingEvent = null;
    flash(ed, "Event saved");
  } catch (err: any) {
    fail(ed, "events", err);
  }
}

function onDeleteEvent(ed: Editor, e: EventForm) {
  ed.events = deleteEvent(e.id);
  ed.editingEvent = null;
}

function onSaveHotel(ed: Editor) {
  try {
    ed.hotels = saveHotel(ed.editingHotel!);
    ed.editingHotel = null;
    flash(ed, "Hotel saved");
  } catch (err: any) {
    fail(ed, "hotels", err);
  }
}

function onDeleteHotel(ed: Editor, h: HotelForm) {
  ed.hotels = deleteHotel(h.id);
  ed.editingHotel = null;
}

function onUpload(ed: Editor) {
  try {
    ed.photos = uploadPhotos(ed.files);
    ed.files = [];
    flash(ed, "Photos uploaded");
  } catch (err: any) {
    fail(ed, "photos", err);
  }
}

function onDeletePhoto(ed: Editor, p: Photo) {
  ed.photos = deletePhoto(p.id);
}

function localLabel(local: string): string {
  let [date, time] = local.split("T");
  let d = new Date(`${date}T12:00:00Z`);
  let [h, m] = time.split(":").map(Number);
  let hour = ((h + 11) % 12) + 1;

  return `${d.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" })}, ${hour}:${String(m).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`;
}

<html lang="en" class="page-admin-site" (
  names: string,
  site: SiteForm,
  events: EventForm[],
  hotels: HotelForm[],
  photos: Photo[],
  private ed: Editor = {
    site,
    events,
    hotels,
    photos,
    editingEvent: null,
    editingHotel: null,
    files: [],
    error: { section: "", message: "" },
  },
)>
  <head>
    <title>Site & photos · {names}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AdminShell {names} active="site">
      <div class="editor stack is-xl">
        <div class="editor-head row">
          <div class="stack is-xs">
            <h1>Site & photos</h1>
            <p class="text-sm">Everything guests see on the wedding site. Changes go live when you save.</p>
          </div>
          <Button size="sm" href="/" attrs={{ target: "_blank" }}>Preview the site</Button>
        </div>

        <form onsubmit={() => onSaveSite(ed, "basics")}>
          <Card title="The basics">
            <CardContent class="stack is-md">
              <div class="field-row">
                <Field label="Partner one" required>
                  <Input value={ed.site.partnerOne} required />
                </Field>
                <Field label="Partner two" required>
                  <Input value={ed.site.partnerTwo} required />
                </Field>
              </div>
              <div class="field-row">
                <Field label="Ceremony starts" description={`Time in ${ed.site.timeZone.replace("_", " ")}. The countdown runs to this.`}>
                  <div class="when row">
                    <DatePicker value={datePart(ed.site.weddingLocal)}
                                format={{ dateStyle: "medium" }}
                                onValueChange={(d) => ed.site.weddingLocal = joinLocal(d, timePart(ed.site.weddingLocal))}
                                block
                                required />
                    <TimePicker value={timePart(ed.site.weddingLocal)}
                                onValueChange={(t) => ed.site.weddingLocal = joinLocal(datePart(ed.site.weddingLocal), t)}
                                block
                                label="Ceremony time"
                                required />
                  </div>
                </Field>
                <Field label="Reply by">
                  <DatePicker value={ed.site.rsvpBy} block />
                </Field>
              </div>
              <div class="field-row">
                <Field label="Venue">
                  <Input value={ed.site.venue} />
                </Field>
                <Field label="City">
                  <Input value={ed.site.city} />
                </Field>
              </div>
              <Field label="Tagline">
                <Input value={ed.site.tagline} placeholder="A line under your names" />
              </Field>
              <Alert e:if={ed.error.section === "basics"} variant="danger" description={ed.error.message} />
            </CardContent>
            <CardFooter>
              <Button type="submit" variant="primary">Save</Button>
            </CardFooter>
          </Card>
        </form>

        <form onsubmit={() => onSaveSite(ed, "story")}>
          <Card title="Your story">
            <CardContent class="stack is-md">
              <Field label="Heading">
                <Input value={ed.site.storyTitle} />
              </Field>
              <Field label="Story" description="Leave a blank line between paragraphs.">
                <Textarea rows={10} value={ed.site.story} />
              </Field>
              <Alert e:if={ed.error.section === "story"} variant="danger" description={ed.error.message} />
            </CardContent>
            <CardFooter>
              <Button type="submit" variant="primary">Save</Button>
            </CardFooter>
          </Card>
        </form>

        <Card title="Schedule">
          <CardContent class="stack is-md">
            <div e:for={e of ed.events} class="item stack is-sm">
              <div class="item-head row">
                <div class="stack is-xs">
                  <strong>{e.name}</strong>
                  <span class="item-sub">{localLabel(e.startsLocal)} · {e.place}</span>
                </div>
                <Button size="sm" onclick={() => ed.editingEvent = { ...e }}>Edit</Button>
              </div>
              <EventEditor e:if={ed.editingEvent?.id === e.id} {ed} />
            </div>

            <EventEditor e:if={ed.editingEvent && !ed.editingEvent.id} {ed} />
            <div e:if={!ed.editingEvent || ed.editingEvent.id}>
              <Button onclick={() => ed.editingEvent = blankEvent(ed.site)}>Add an event</Button>
            </div>
          </CardContent>
        </Card>

        <form onsubmit={() => onSaveSite(ed, "travel")}>
          <Card title="Travel">
            <CardContent class="stack is-md">
              <Field label="Getting here" description="Airports, trains, parking, shuttles. Leave a blank line between paragraphs.">
                <Textarea rows={7} value={ed.site.travel} />
              </Field>
            </CardContent>
            <CardFooter>
              <Button type="submit" variant="primary">Save</Button>
            </CardFooter>
          </Card>
        </form>

        <Card title="Hotels">
          <CardContent class="stack is-md">
            <div e:for={h of ed.hotels} class="item stack is-sm">
              <div class="item-head row">
                <div class="stack is-xs">
                  <strong>{h.name}</strong>
                  <span class="item-sub">{h.address}</span>
                </div>
                <Button size="sm" onclick={() => ed.editingHotel = { ...h }}>Edit</Button>
              </div>
              <HotelEditor e:if={ed.editingHotel?.id === h.id} {ed} />
            </div>

            <HotelEditor e:if={ed.editingHotel && !ed.editingHotel.id} {ed} />
            <div e:if={!ed.editingHotel || ed.editingHotel.id}>
              <Button onclick={() => ed.editingHotel = blankHotel()}>Add a hotel</Button>
            </div>
          </CardContent>
        </Card>

        <Card title="Photos">
          <CardContent class="stack is-lg">
            <form class="upload row" onsubmit={() => onUpload(ed)}>
              <Input type="file" multiple files={ed.files} attrs={{ accept: "image/*", "aria-label": "Photos to upload" }} />
              <Button type="submit" variant="primary" disabled={ed.files.length === 0}>Upload</Button>
            </form>
            <Alert e:if={ed.error.section === "photos"} variant="danger" description={ed.error.message} />

            <div class="photos">
              <div e:for={[i, p] of ed.photos.entries()} class={["photo", ed.site.coverPhotoId === p.id && "is-cover"]}>
                <div class="photo-img">
                  <img src={photoUrl(p)} alt={p.caption} loading="lazy">
                  <Badge e:if={ed.site.coverPhotoId === p.id} variant="accent">Cover</Badge>
                </div>
                <div class="photo-body stack is-sm">
                  <Input value={p.caption} placeholder="Caption" attrs={{ "aria-label": "Caption" }} onchange={() => captionPhoto(p.id, p.caption)} />
                  <div class="photo-actions row">
                    <div class="row">
                      <Button size="xs" variant="ghost" icon label="Move earlier" disabled={i === 0} onclick={() => ed.photos = movePhoto(p.id, -1)}><Icon name="arrow-left" /></Button>
                      <Button size="xs" variant="ghost" icon label="Move later" disabled={i === ed.photos.length - 1} onclick={() => ed.photos = movePhoto(p.id, 1)}><Icon name="arrow-right" /></Button>
                    </div>
                    <div class="row">
                      <Button e:if={ed.site.coverPhotoId !== p.id} size="xs" variant="ghost" onclick={() => ed.site = setCover(p.id)}>Make cover</Button>
                      <AlertDialog title="Remove this photo from the gallery?">
                        <Button slot="trigger" size="xs" variant="ghost">Remove</Button>
                        <AlertDialogFooter>
                          <AlertDialogCancel>Cancel</AlertDialogCancel>
                          <AlertDialogAction variant="danger" onclick={() => onDeletePhoto(ed, p)}>Remove</AlertDialogAction>
                        </AlertDialogFooter>
                      </AlertDialog>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </AdminShell>
  </body>
</html>

<EventEditor (ed: Editor)>
  <form class="stack is-md" onsubmit={() => onSaveEvent(ed)}>
    <div class="field-row">
      <Field label="Event" required>
        <Input value={ed.editingEvent!.name} placeholder="Rehearsal dinner" required />
      </Field>
      <Field label="Starts">
        <div class="when row">
          <DatePicker value={datePart(ed.editingEvent!.startsLocal)}
                      format={{ dateStyle: "medium" }}
                      onValueChange={(d) => ed.editingEvent!.startsLocal = joinLocal(d, timePart(ed.editingEvent!.startsLocal))}
                      block
                      required />
          <TimePicker value={timePart(ed.editingEvent!.startsLocal)}
                      onValueChange={(t) => ed.editingEvent!.startsLocal = joinLocal(datePart(ed.editingEvent!.startsLocal), t)}
                      block
                      label="Event time"
                      required />
        </div>
      </Field>
    </div>
    <div class="field-row">
      <Field label="Place">
        <Input value={ed.editingEvent!.place} />
      </Field>
      <Field label="Address">
        <Input value={ed.editingEvent!.address} />
      </Field>
      <Field label="Attire">
        <Input value={ed.editingEvent!.attire} placeholder="Cocktail attire" />
      </Field>
    </div>
    <Field label="Details">
      <Textarea rows={2} value={ed.editingEvent!.details} />
    </Field>
    <Alert e:if={ed.error.section === "events"} variant="danger" description={ed.error.message} />
    <div class="cluster is-sm">
      <Button type="submit" variant="primary" size="sm">Save event</Button>
      <Button size="sm" onclick={() => ed.editingEvent = null}>Cancel</Button>
      <AlertDialog e:if={ed.editingEvent!.id} title={`Remove ${ed.editingEvent!.name} from the schedule?`}>
        <Button slot="trigger" size="sm" variant="danger">Remove</Button>
        <AlertDialogFooter>
          <AlertDialogCancel>Cancel</AlertDialogCancel>
          <AlertDialogAction variant="danger" onclick={() => onDeleteEvent(ed, ed.editingEvent!)}>Remove</AlertDialogAction>
        </AlertDialogFooter>
      </AlertDialog>
    </div>
  </form>
</EventEditor>

<HotelEditor (ed: Editor)>
  <form class="stack is-md" onsubmit={() => onSaveHotel(ed)}>
    <div class="field-row">
      <Field label="Hotel" required>
        <Input value={ed.editingHotel!.name} required />
      </Field>
      <Field label="Address">
        <Input value={ed.editingHotel!.address} />
      </Field>
      <Field label="Booking link">
        <Input type="url" value={ed.editingHotel!.url} placeholder="https://" />
      </Field>
    </div>
    <Field label="Details">
      <Textarea rows={2} value={ed.editingHotel!.details} placeholder="Room block, rate, booking deadline" />
    </Field>
    <Alert e:if={ed.error.section === "hotels"} variant="danger" description={ed.error.message} />
    <div class="cluster is-sm">
      <Button type="submit" variant="primary" size="sm">Save hotel</Button>
      <Button size="sm" onclick={() => ed.editingHotel = null}>Cancel</Button>
      <AlertDialog e:if={ed.editingHotel!.id} title={`Remove ${ed.editingHotel!.name}?`}>
        <Button slot="trigger" size="sm" variant="danger">Remove</Button>
        <AlertDialogFooter>
          <AlertDialogCancel>Cancel</AlertDialogCancel>
          <AlertDialogAction variant="danger" onclick={() => onDeleteHotel(ed, ed.editingHotel!)}>Remove</AlertDialogAction>
        </AlertDialogFooter>
      </AlertDialog>
    </div>
  </form>
</HotelEditor>
