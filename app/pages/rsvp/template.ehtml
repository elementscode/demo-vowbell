import "./style.css";
import { sql, tx, email, NotFoundError, ValidationError } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader, SiteFooter } from "#app/shared/templates/site-header";
import { Site, MEALS, mealLabel, formatDay, loadSite } from "#app/shared/services/wedding";
import { Party, PartyGuest, rsvpChannel, loadPartyByCode, normalizeCode } from "#app/shared/services/guests";
import RsvpConfirmationEmail from "#app/emails/rsvp-confirmation";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent, CardFooter } from "@elements/ui/card";
import { Field, FieldLabel, FieldContent, FieldTitle, FieldDescription, FieldSet, FieldLegend } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";
import { Table, TableCell } from "@elements/ui/table";
import { Textarea } from "@elements/ui/textarea";

export interface GuestReply {
  id: string;
  attending: boolean | null;
  meal: string;
  dietary: string;
}

export interface RsvpReply {
  code: string;
  email: string;
  song: string;
  message: string;
  guests: GuestReply[];
}

type Step = "code" | "reply" | "done";

interface RsvpState {
  step: Step;
  code: string;
  error: string;
  busy: boolean;
  party: Party | null;
  reply: RsvpReply;
}

/** @rpc */
export function findInvitation(code: string): Party {
  let party = loadPartyByCode(code);

  if (!party) {
    throw new NotFoundError("We couldn't find that code. Check your invitation and try again.");
  }

  return party;
}

export function checkReply(reply: RsvpReply, party: Party) {
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(reply.email.trim())) {
    throw new ValidationError("Enter an email address so we can send your confirmation.");
  }

  for (let g of party.guests) {
    let r = reply.guests.find((x) => x.id === g.id);

    if (!r || typeof r.attending !== "boolean") {
      throw new ValidationError(`Let us know whether ${g.name} can come.`);
    }

    if (r.attending && !MEALS.some((m) => m.value === r.meal)) {
      throw new ValidationError(`Choose a dinner for ${g.name}.`);
    }
  }
}

/** @rpc */
export function submitRsvp(reply: RsvpReply): Party {
  let party = findInvitation(reply.code);
  checkReply(reply, party);

  tx(() => {
    for (let g of party.guests) {
      let r = reply.guests.find((x) => x.id === g.id)!;

      sql(
        `update guests
         set attending = ${r.attending},
             meal = ${r.attending ? r.meal : null},
             dietary = ${r.attending ? r.dietary.trim() : ""}
         where id = ${g.id} and partyId = ${party.id}`,
      );
    }

    sql(
      `update parties
       set email = ${reply.email.trim().toLowerCase()},
           song = ${reply.song.trim()},
           message = ${reply.message.trim()},
           respondedAt = now()
       where id = ${party.id}`,
    );
  });

  let saved = findInvitation(reply.code);

  email({
    to: saved.email,
    subject: "Your RSVP is in",
    body: new RsvpConfirmationEmail({ site: loadSite(), party: saved }),
  });

  rsvpChannel.notify({ partyId: saved.id });

  return saved;
}

export function replyFor(party: Party): RsvpReply {
  return {
    code: party.code,
    email: party.email,
    song: party.song,
    message: party.message,
    guests: party.guests.map((g) => ({ id: g.id, attending: g.attending, meal: g.meal ?? "", dietary: g.dietary })),
  };
}

function emptyReply(): RsvpReply {
  return { code: "", email: "", song: "", message: "", guests: [] };
}

function initialState(party: Party | null, code: string): RsvpState {
  return {
    step: (party ? "reply" : "code") as Step,
    code: party?.code ?? code,
    error: party || !code ? "" : "We couldn't find that code. Check your invitation and try again.",
    busy: false,
    party,
    reply: party ? replyFor(party) : emptyReply(),
  };
}

function guestName(party: Party | null, id: string): string {
  return party?.guests.find((g) => g.id === id)?.name ?? "";
}

function replyLine(g: PartyGuest): string {
  if (!g.attending) {
    return "Regretfully declines";
  }

  return mealLabel(g.meal) || "Attending";
}

function onFind(state: RsvpState) {
  state.busy = true;

  try {
    let party = findInvitation(normalizeCode(state.code));
    state.party = party;
    state.reply = replyFor(party);
    state.error = "";
    state.step = "reply";
  } catch (err: any) {
    state.error = err.message;
  }

  state.busy = false;
}

function answer(r: GuestReply): string {
  return r.attending === true ? "yes" : r.attending === false ? "no" : "";
}

function onAttend(r: GuestReply, attending: boolean) {
  r.attending = attending;

  if (!attending) {
    r.meal = "";
  }
}

function onSubmit(state: RsvpState) {
  state.busy = true;

  try {
    state.party = submitRsvp(state.reply);
    state.error = "";
    state.step = "done";
    window.scrollTo({ top: 0, behavior: "smooth" });
  } catch (err: any) {
    state.error = err.message;
  }

  state.busy = false;
}

function onStartOver(state: RsvpState) {
  state.step = "code";
  state.code = "";
  state.party = null;
  state.reply = emptyReply();
  state.error = "";
}

<html lang="en" class="page-rsvp is-wedding" (
  site: Site,
  initial: Party | null,
  initialCode: string,
  private state: RsvpState = initialState(initial, initialCode),
)>
  <head>
    <title>RSVP · {site.partnerOne} & {site.partnerTwo}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <SiteHeader {site} />

    <main class="rsvp-main page-shell is-form">
      <div class="rsvp-head stack is-sm">
        <p class="eyebrow">Kindly reply</p>
        <h1 class="script">RSVP</h1>
        <p e:if={site.rsvpBy}>Please respond by {formatDay(site.rsvpBy!, "UTC")}.</p>
      </div>

      <div e:switch={state.step}>
        <form e:case="code" onsubmit={() => onFind(state)}>
          <Card class="rsvp-card">
            <CardContent class="stack is-lg">
              <Field label="Invitation code" description="It's printed on the back of your invitation card." required>
                <Input class="code-input"
                       name="code"
                       value={state.code}
                       placeholder="ABC123"
                       required
                       attrs={{ autocomplete: "off", autocapitalize: "characters", spellcheck: "false", maxlength: 12 }} />
              </Field>

              <Alert e:if={state.error} variant="danger" description={state.error} />

              <Button type="submit" variant="primary" size="lg" block loading={state.busy}>Find my invitation</Button>
            </CardContent>
          </Card>
        </form>

        <form e:case="reply" onsubmit={() => onSubmit(state)}>
          <Card class="rsvp-card" title={state.party?.name ?? ""} level={2}>
            <CardAction slot="action">
              <Badge e:if={state.party?.respondedAt} variant="success">Replied {state.party!.respondedAt!.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</Badge>
            </CardAction>

            <CardContent class="stack is-lg">
              <div>
                <div e:for={r of state.reply.guests} class="guest stack is-md">
                  <h3 class="guest-name">{guestName(state.party, r.id)}</h3>

                  <RadioGroup class="choice"
                              value={answer(r)}
                              name={`attending-${r.id}`}
                              onValueChange={(v) => onAttend(r, v === "yes")}
                              attrs={{ "aria-label": `Reply for ${guestName(state.party, r.id)}` }}>
                    <FieldLabel>
                      <Field orientation="horizontal" reserveError={false}>
                        <RadioGroupItem value="yes" />
                        <FieldTitle>Joyfully accepts</FieldTitle>
                      </Field>
                    </FieldLabel>
                    <FieldLabel>
                      <Field orientation="horizontal" reserveError={false}>
                        <RadioGroupItem value="no" />
                        <FieldTitle>Regretfully declines</FieldTitle>
                      </Field>
                    </FieldLabel>
                  </RadioGroup>

                  <FieldSet e:if={r.attending === true}>
                    <FieldLegend variant="label">Dinner</FieldLegend>
                    <RadioGroup class="meals" value={r.meal} name={`meal-${r.id}`} attrs={{ "aria-label": `Dinner for ${guestName(state.party, r.id)}` }}>
                      <FieldLabel e:for={m of MEALS}>
                        <Field orientation="horizontal" reserveError={false}>
                          <RadioGroupItem value={m.value} />
                          <FieldContent>
                            <FieldTitle>{m.label}</FieldTitle>
                            <FieldDescription>{m.note}</FieldDescription>
                          </FieldContent>
                        </Field>
                      </FieldLabel>
                    </RadioGroup>
                  </FieldSet>

                  <Field e:if={r.attending === true} label="Allergies or dietary needs">
                    <Input value={r.dietary} placeholder="Optional" />
                  </Field>
                </div>
              </div>

              <Field label="Email for your confirmation" required>
                <Input name="email" type="email" value={state.reply.email} required attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Request a song">
                <Input value={state.reply.song} placeholder="The one that gets you on the dance floor" />
              </Field>

              <Field label="A note for the couple">
                <Textarea rows={3} value={state.reply.message} placeholder="Optional" />
              </Field>

              <Alert e:if={state.error} variant="danger" description={state.error} />
            </CardContent>

            <CardFooter>
              <Button variant="link" onclick={() => onStartOver(state)}>Not you?</Button>
              <Button type="submit" variant="primary" loading={state.busy}>Send RSVP</Button>
            </CardFooter>
          </Card>
        </form>

        <Card e:case="done" class="rsvp-card">
          <CardContent class="done stack is-lg">
            <h2 e:if={state.party?.guests.some((g) => g.attending)} class="script">See you in the orchard</h2>
            <h2 e:else class="script">We'll miss you</h2>
            <p>Thank you, {state.party?.name}. A confirmation is on its way to {state.party?.email}.</p>

            <Table class="summary">
              <table>
                <tbody>
                  <tr e:for={g of state.party?.guests ?? []}>
                    <TableCell>{g.name}</TableCell>
                    <TableCell align="end">{replyLine(g)}</TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>

            <div class="cluster replied">
              <Button onclick={() => state.step = "reply"}>Change my reply</Button>
              <Button variant="primary" href="/">Back to the site</Button>
            </div>
          </CardContent>
        </Card>
      </div>
    </main>

    <SiteFooter {site} />
  </body>
</html>
