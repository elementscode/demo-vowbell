import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Site, coupleNames } from "#app/shared/services/wedding";
import { signin, DEMO_LOGIN } from "#app/shared/services/auth";
import { Alert, AlertTitle, AlertDescription } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/admin");
  } catch (err: any) {
    form.error = err.message;
  }
}

function onUseDemo(form: SigninForm) {
  form.email = DEMO_LOGIN.email;
  form.password = DEMO_LOGIN.password;
}

<html lang="en" class="page-signin is-wedding" (
  site: Site,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Sign in · {coupleNames(site)}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="signin-main center">
      <div class="signin stack is-lg">
        <div class="signin-head stack is-sm">
          <h1 class="script">{coupleNames(site)}</h1>
          <p>Sign in to manage your wedding site.</p>
        </div>

        <form onsubmit={() => onSubmit(form)}>
          <Card>
            <CardContent class="stack is-md">
              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email" required>
                <Input name="email"
                       type="email"
                       value={form.email}
                       required
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" required>
                <Input name="password"
                       type="password"
                       value={form.password}
                       required
                       attrs={{ id: "password", autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block>Sign in</Button>
            </CardContent>
          </Card>
        </form>

        <Alert variant="accent" role="none" class="demo-login">
          <AlertTitle>Demo admin login</AlertTitle>
          <AlertDescription class="stack is-sm">
            <dl>
              <dt>Email</dt>
              <dd>{DEMO_LOGIN.email}</dd>
              <dt>Password</dt>
              <dd>{DEMO_LOGIN.password}</dd>
            </dl>
            <div><Button size="sm" onclick={() => onUseDemo(form)}>Fill it in for me</Button></div>
          </AlertDescription>
        </Alert>

        <p class="signin-back"><a class="link-muted" href="/">Back to the wedding site</a></p>
      </div>
    </main>
  </body>
</html>
