import "./style.css";
import type { Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { DataTable, DataTableColumn, DataRow } from "@elements/ui/data-table";
import { Empty } from "@elements/ui/empty";
import { Progress } from "@elements/ui/progress";
import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";
import { AdminShell } from "#app/shared/templates/admin-shell";
import { coupleOrThrow } from "#app/shared/services/auth";
import { MEALS, mealLabel } from "#app/shared/services/wedding";
import { Party, loadParties } from "#app/shared/services/guests";

export type Filter = "all" | "attending" | "declined" | "waiting";

export interface Stats {
  invited: number;
  attending: number;
  declined: number;
  waiting: number;
  partiesReplied: number;
  parties: number;
  meals: { value: string; label: string; count: number }[];
  dietary: { who: string; note: string }[];
  songs: { who: string; song: string }[];
}

interface Tracker {
  parties: Party[];
  filter: Filter;
  search: string;
  fresh: string;
}

/** @rpc */
export function fetchParties(): Party[] {
  coupleOrThrow();

  return loadParties();
}

export function trackerStats(parties: Party[]): Stats {
  let guests = parties.flatMap((p) => p.guests);
  let going = guests.filter((g) => g.attending === true);

  return {
    invited: guests.length,
    attending: going.length,
    declined: guests.filter((g) => g.attending === false).length,
    waiting: guests.filter((g) => g.attending === null).length,
    partiesReplied: parties.filter((p) => p.respondedAt).length,
    parties: parties.length,
    meals: MEALS.map((m) => ({ value: m.value, label: m.label, count: going.filter((g) => g.meal === m.value).length })),
    dietary: going.filter((g) => g.dietary).map((g) => ({ who: g.name, note: g.dietary })),
    songs: parties.filter((p) => p.song).map((p) => ({ who: p.name, song: p.song })),
  };
}

export function partyStatus(p: Party): Filter {
  if (!p.respondedAt) {
    return "waiting";
  }

  return p.guests.some((g) => g.attending) ? "attending" : "declined";
}

/** The parties under the active filter, by name; the table sorts them by reply. */
export function visibleParties(t: Tracker): Party[] {
  return t.parties
    .filter((p) => t.filter === "all" || partyStatus(p) === t.filter)
    .sort((a, b) => a.name.localeCompare(b.name));
}

function percent(n: number, of: number): string {
  return of === 0 ? "0%" : `${(n / of) * 100}%`;
}

function when(d: Date | null): string {
  if (!d) {
    return "";
  }

  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" }) + ", " + d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
}

function mark(attending: boolean | null): string {
  return attending === true ? "✓" : attending === false ? "✕" : "·";
}

function guestLine(g: Party["guests"][number]): string {
  return `${mark(g.attending)} ${g.name}${g.attending ? ` (${mealLabel(g.meal)})` : ""}`;
}

const COLUMNS: DataTableColumn[] = [
  {
    id: "party",
    header: "Party",
    rowHeader: true,
    value: (p: DataRow) => `${p.name} ${p.code}`,
    cell: (p: DataRow) => ({ text: p.name, description: p.code }),
  },
  {
    id: "guests",
    header: "Guests",
    type: "multiline",
    sortable: false,
    value: (p: DataRow) => (p as Party).guests.map(guestLine).join("\n"),
  },
  { key: "message", header: "Note", wrap: true, sortable: false },
  {
    id: "replied",
    header: "Replied",
    value: (p: DataRow) => p.respondedAt,
    sortUndefined: "last",
    cell: (p: DataRow) => p.respondedAt ? when(p.respondedAt) : { text: "Waiting", tone: "warning" },
  },
];

function onNotify(t: Tracker, partyId: string) {
  t.parties = fetchParties();
  t.fresh = partyId;
  setTimeout(() => onFreshDone(t, partyId), 2400);
}

function onFreshDone(t: Tracker, partyId: string) {
  if (t.fresh === partyId) {
    t.fresh = "";
  }
}

function onInit(listener: Listener<{ partyId: string }>, t: Tracker) {
  listener.on("notify", (msg) => onNotify(t, msg.partyId));
}

const FILTERS: { key: Filter; label: string }[] = [
  { key: "all", label: "All" },
  { key: "attending", label: "Attending" },
  { key: "declined", label: "Declined" },
  { key: "waiting", label: "Waiting" },
];

function filterCount(t: Tracker, f: Filter): number {
  return f === "all" ? t.parties.length : t.parties.filter((p) => partyStatus(p) === f).length;
}

<html lang="en" class="page-admin-rsvps" (
  names: string,
  initial: Party[],
  listener: Listener<{ partyId: string }>,
  private t: Tracker = { parties: initial, filter: "all" as Filter, search: "", fresh: "" },
) oninit={() => onInit(listener, t)}>
  <head>
    <title>RSVPs · {names}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AdminShell {names} active="rsvps">
      <div class="stack is-xl">
        <div class="tracker-head row">
          <div class="stack is-xs">
            <h1>RSVP tracker</h1>
            <p class="text-sm">{trackerStats(t.parties).partiesReplied} of {trackerStats(t.parties).parties} invitations answered</p>
          </div>
          <div class="cluster is-sm">
            <Badge variant="success" dot class="live">Live</Badge>
            <Button size="sm" href="/admin/rsvps.csv" attrs={{ download: "rsvps.csv" }}>Export CSV</Button>
          </div>
        </div>

        <div class="stats">
          <Card size="sm" class="stat">
            <CardContent>
              <p class="stat-label">Invited</p>
              <p class="stat-value">{trackerStats(t.parties).invited}</p>
              <div class="progress-bar" aria-hidden="true">
                <span class="is-attending" style={{ width: percent(trackerStats(t.parties).attending, trackerStats(t.parties).invited) }}></span>
                <span class="is-declined" style={{ width: percent(trackerStats(t.parties).declined, trackerStats(t.parties).invited) }}></span>
              </div>
            </CardContent>
          </Card>
          <Card size="sm" class="stat is-attending">
            <CardContent>
              <p class="stat-label">Attending</p>
              <p class="stat-value">{trackerStats(t.parties).attending}</p>
              <p class="stat-note">guests coming</p>
            </CardContent>
          </Card>
          <Card size="sm" class="stat is-declined">
            <CardContent>
              <p class="stat-label">Declined</p>
              <p class="stat-value">{trackerStats(t.parties).declined}</p>
              <p class="stat-note">can't make it</p>
            </CardContent>
          </Card>
          <Card size="sm" class="stat is-waiting">
            <CardContent>
              <p class="stat-label">Waiting</p>
              <p class="stat-value">{trackerStats(t.parties).waiting}</p>
              <p class="stat-note">haven't replied</p>
            </CardContent>
          </Card>
        </div>

        <div class="meals-row">
          <Card title="Meal counts">
            <CardContent>
              <ul class="meal-counts">
                <li e:for={m of trackerStats(t.parties).meals} e:key={(m: { value: string }) => m.value}>
                  <span>{m.label}</span>
                  <strong>{m.count}</strong>
                  <Progress class="meal-bar" value={m.count} max={Math.max(trackerStats(t.parties).attending, 1)} size="lg" attrs={{ "aria-label": `${m.label}: ${m.count}` }} />
                </li>
              </ul>
            </CardContent>
          </Card>

          <Card title="Dietary notes">
            <CardContent>
              <ul e:if={trackerStats(t.parties).dietary.length > 0} class="notes">
                <li e:for={d of trackerStats(t.parties).dietary} e:key={(d: { who: string }) => d.who}>
                  <span class="who">{d.who}</span>
                  {d.note}
                </li>
              </ul>
              <p e:else class="text-sm">None yet.</p>
            </CardContent>
          </Card>

          <Card title="Song requests">
            <CardContent>
              <ul e:if={trackerStats(t.parties).songs.length > 0} class="notes">
                <li e:for={s of trackerStats(t.parties).songs} e:key={(s: { who: string }) => s.who}>
                  <span class="who">{s.who}</span>
                  {s.song}
                </li>
              </ul>
              <p e:else class="text-sm">None yet.</p>
            </CardContent>
          </Card>
        </div>

        <div class="stack is-md">
          <Tabs value={t.filter} class="filters">
            <TabsList label="Filter parties">
              <TabsTrigger e:for={f of FILTERS} e:key={(f: { key: string }) => f.key} value={f.key}>
                {f.label} <span class="text-xs">{filterCount(t, f.key)}</span>
              </TabsTrigger>
            </TabsList>
          </Tabs>

          <DataTable class="parties"
                     data={visibleParties(t)}
                     columns={COLUMNS}
                     label="Parties"
                     search={t.search}
                     searchPlaceholder="Search names or codes"
                     sorting={[{ id: "replied", desc: true }]}
                     columnMenu={false}
                     filterable={false}
                     exportable={false}
                     hideable={false}
                     reorderable={false}
                     resizable={false}
                     pinnable={false}
                     groupable={false}
                     viewMenu={false}
                     savedViews={false}
                     pagination={false}
                     footer={false}
                     rowTone={(p: DataRow) => p.id === t.fresh ? "success" : ""}>
            <Empty slot="empty" description="No parties match." />
          </DataTable>
        </div>
      </div>
    </AdminShell>
  </body>
</html>
