import "./style.css";
import { redirect } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";
import { signout } from "#app/shared/services/auth";

const TABS = [
  { key: "rsvps", label: "RSVPs", href: "/admin" },
  { key: "guests", label: "Guest list", href: "/admin/guests" },
  { key: "site", label: "Site & photos", href: "/admin/site" },
];

function onSignout() {
  signout();
  redirect("/signin");
}

<AdminShell (names: string, active: string)>
  <header class="admin-bar">
    <div class="admin-bar-inner row">
      <div class="admin-brand row">
        <a class="admin-brand-names" href="/admin">{names}</a>
        <Badge variant="accent">Admin</Badge>
      </div>

      <Tabs value={active} class="admin-tabs">
        <TabsList label="Admin">
          <TabsTrigger e:for={t of TABS} value={t.key} href={t.href}>{t.label}</TabsTrigger>
        </TabsList>
      </Tabs>

      <div class="admin-actions cluster is-sm">
        <Button variant="ghost" size="sm" href="/" attrs={{ target: "_blank" }}>View site</Button>
        <Button size="sm" onclick={() => onSignout()}>Sign out</Button>
      </div>
    </div>
  </header>

  <main class="admin-main page-shell is-wide">
    <slot/>
  </main>
</AdminShell>
